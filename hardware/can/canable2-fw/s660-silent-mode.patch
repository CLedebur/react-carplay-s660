+// S660: report silent mode. On bus, read the peripheral's own CCCR.MON bit,
+// so the answer is what the hardware is doing, not what was requested.
+uint8_t can_is_silent(void)
+{
+    if (bus_state == ON_BUS)
+    {
+        return (FDCAN1->CCCR & FDCAN_CCCR_MON) ? 1 : 0;
+    }
+    return (can_mode == FDCAN_MODE_BUS_MONITORING) ? 1 : 0;
+}
