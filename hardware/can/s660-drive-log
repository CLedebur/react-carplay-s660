#!/usr/bin/python3
# Drive recorder (BUILD_NOTES §40): records every drive to /persist/can/drives/ while Settings >
# Options > Drive recording is on. Runs as s660-drive-log.service, from boot to shutdown.
#
#   off     nothing is recorded
#   listen  the bus, as heard (candump -L): nothing is ever sent
#   engine  the bus, plus read-only OBD requests to the engine computer (s660-diag poll, S660-diagnostics.md
#           stage 5): the adapter leaves silent mode for as long as the recording runs
#
# A recording starts when the car's own broadcast is heard and stops 10 s after it goes quiet
# (ignition off), so every ignition-on is one file, however many stops a trip has. The setting is
# re-read every 2 s, so a change applies at once (a new file in the new mode). The newest recordings
# are kept up to CAP_BYTES; the oldest go first. The state is in /run/s660-drive-log.json for the UI.
import collections, glob, json, os, re, signal, socket, struct, subprocess, sys, threading, time

SETTINGS = os.environ.get("S660_SETTINGS_FILE", "/persist/ui/settings.json")
DIR = os.environ.get("S660_DRIVE_DIR", "/persist/can/drives")
STATUS = os.environ.get("S660_DRIVE_STATUS", "/run/s660-drive-log.json")
IFACE = os.environ.get("S660_DIAG_IFACE", "can0")
DIAG = os.environ.get("S660_DIAG", "/usr/local/sbin/s660-diag")
SESSION = os.environ.get("S660_DIAG_SESSION", "/run/s660-diag-session")
OWN = SESSION + ".drive-log"            # our session, as opposed to a manual s660-diag one
CAP_BYTES = 20 * 1024 ** 3
QUIET_S = 10                            # bus silent this long = ignition off: the recording ends
TICK_S = 1
# Load, coolant, trims, MAP, rpm, speed, timing, intake, throttle, wide-band O2, catalyst, absolute
# load, commanded lambda; the module voltage (42) four times, for the battery monitor; the
# check-engine status (01), the stored and pending fault codes (s03, s07) and the cluster's range,
# fuel and km/L (60:702A). 22 requests at 5 per second: the voltage about every 1.1 s, the rest 4.4 s.
PIDS = "42 04 05 06 42 07 0B 0C 0D 42 0E 0F 11 34 42 3C 43 44 01 s03 s07 60:702A".split()
BATTERY_SAMPLES = 900                  # about 15 minutes of voltage readings for the panel's trend
REPLY = re.compile(r"-> ([0-9a-f ]+?)\s{3}\S+ <- ([0-9a-f ]+)$")    # s660-diag's line for each request
POLL_RATE = "5"
# Research requests (S660-diagnostics.md stage 6c), only while this file exists: whitespace-separated s660-diag poll
# tokens, '#' starts a comment. They are spread evenly between two rounds of PIDS and the rate goes to
# EXTRA_RATE, so PIDS keep their pace (52 extras: each one about every 10 s). Delete the file to stop.
EXTRA = os.environ.get("S660_DRIVE_EXTRA", "/persist/can/drive-extra-items")
EXTRA_RATE = "10"


def poll_items():
    """(rate, tokens) for s660-diag poll: PIDS alone, or PIDS twice with the extras spread between."""
    try:
        extra = " ".join(l.split("#")[0] for l in open(EXTRA)).split()
    except OSError:
        extra = []
    if not extra:
        return POLL_RATE, PIDS
    base, items = PIDS * 2, []
    for i, tok in enumerate(base):
        items.append(tok)
        items += extra[len(extra) * i // len(base):len(extra) * (i + 1) // len(base)]
    return EXTRA_RATE, items


def mode_setting():
    try:
        v = json.load(open(SETTINGS)).get("driveLog", "off")
    except (OSError, ValueError):
        v = "off"
    return v if v in ("off", "listen", "engine") else "off"


def bus_heard(timeout=1.0):
    """True if the car broadcast a frame within `timeout`. Only 11-bit frames count: the car's
    broadcast is all 11-bit, our own OBD requests (which the host sees too) are 29-bit."""
    try:
        s = socket.socket(socket.AF_CAN, socket.SOCK_RAW, socket.CAN_RAW)
        s.setsockopt(socket.SOL_CAN_RAW, socket.CAN_RAW_FILTER,
                     struct.pack("=II", 0, socket.CAN_EFF_FLAG | socket.CAN_RTR_FLAG))
        s.bind((IFACE,))
        s.settimeout(timeout)
        s.recv(16)
        s.close()
        return True
    except OSError:                       # no can0 yet, or a timeout
        return False


def boot_tag():
    try:
        return open("/proc/sys/kernel/random/boot_id").read()[:4]
    except OSError:
        return "0000"


def prune():
    files = sorted(glob.glob(os.path.join(DIR, "*")), key=os.path.getmtime)
    total = sum(os.path.getsize(f) for f in files)
    while files and total > CAP_BYTES:
        f = files.pop(0)
        total -= os.path.getsize(f)
        os.remove(f)


class Recorder:
    def __init__(self):
        self.mode = None                  # the mode of the recording running, or None
        self.base = None
        self.since = None
        self.engine = False               # requests are being sent right now
        self.note = ""
        self.dump = self.poll = None
        self.obd = {}                     # PID -> {"hex": reply data, "t": when}, the latest of each
        self.battery = collections.deque(maxlen=BATTERY_SAMPLES)   # (t, mV)

    def start(self, mode):
        os.makedirs(DIR, exist_ok=True)
        prune()
        # The clock is only right once the Pi has been online; the boot tag keeps names apart.
        self.base = os.path.join(DIR, f"{time.strftime('%Y-%m-%d-%H%M%S')}-{boot_tag()}-{mode}")
        self.mode, self.since, self.note = mode, time.time(), ""
        self.obd, self.battery = {}, collections.deque(maxlen=BATTERY_SAMPLES)
        if mode == "engine":
            if os.path.exists(SESSION) and not os.path.exists(OWN):
                self.note = "engine data paused: a manual diagnostic session is open"
            elif subprocess.run([DIAG, "session-start"]).returncode == 0:
                open(OWN, "w").write(str(os.getpid()))
                self.engine = True
            else:
                self.note = "engine data off: the adapter did not confirm M0"
        self.dump_start()
        if self.engine:
            env = dict(os.environ, S660_DIAG_LOG=self.base + ".jsonl")
            for svc in ("03", "07"):          # stored and pending fault codes, once per drive
                subprocess.run([DIAG, "obd", "--29", svc], env=env, stdout=subprocess.DEVNULL)
            rate, items = poll_items()
            self.poll = subprocess.Popen([DIAG, "poll", rate] + items, env=env, stdout=subprocess.PIPE, text=True)
            if len(items) > len(PIDS):
                self.note = f"research: {len(items) - 2 * len(PIDS)} extra requests ({EXTRA})"
            threading.Thread(target=self.read_poll, args=(self.poll,), daemon=True).start()
        print(f"recording {self.base} ({mode}{', sending requests' if self.engine else ''}) {self.note}", flush=True)

    def read_poll(self, proc):
        """Keep the latest positive reply to each request, keyed by the request ("01 42", "03",
        "22 70 2a"). Positive = the service + 0x40, echoing the PID or DID."""
        for line in proc.stdout:
            m = REPLY.search(line.strip())
            if not m:
                continue
            req, rep = m.group(1).split(), m.group(2).split()
            if int(rep[0], 16) != int(req[0], 16) + 0x40 or rep[1:len(req)] != req[1:]:
                continue
            now = time.time()
            self.obd[" ".join(req)] = {"hex": " ".join(rep), "t": now}
            if req == ["01", "42"] and len(rep) >= 4:
                self.battery.append((round(now, 1), int(rep[2], 16) << 8 | int(rep[3], 16)))

    def dump_start(self):
        self.dump = subprocess.Popen(["candump", "-L", IFACE], stdout=open(self.base + ".log", "ab"),
                                     stderr=subprocess.DEVNULL)

    def check(self):
        # candump exits when can0 is recreated (a session opening or closing): pick the file up again.
        if self.dump and self.dump.poll() is not None:
            self.dump_start()

    def stop(self):
        for p in (self.poll, self.dump):
            if p and p.poll() is None:
                p.terminate()
                try:
                    p.wait(3)
                except subprocess.TimeoutExpired:
                    p.kill()
        self.poll = self.dump = None
        if os.path.exists(OWN):
            # session-stop sets the adapter back to M1 and verifies it before anything else.
            subprocess.run([DIAG, "session-stop"])
            os.remove(OWN)
        if self.mode:
            print(f"stopped {self.base}", flush=True)
        self.mode, self.engine = None, False

    def status(self, setting, heard):
        size = sum(os.path.getsize(f) for f in glob.glob(self.base + ".*")) if self.mode else 0
        st = {"setting": setting, "recording": self.mode is not None, "engine": self.engine,
              "bus": heard, "since": self.since if self.mode else None, "bytes": size,
              "file": os.path.basename(self.base) if self.mode else None, "note": self.note,
              "obd": dict(self.obd) if self.engine else {}, "battery": list(self.battery) if self.engine else []}
        tmp = STATUS + ".tmp"
        with open(tmp, "w") as f:
            json.dump(st, f)
        os.replace(tmp, STATUS)


def main():
    rec = Recorder()

    def bye(*_):
        rec.stop()
        try:
            os.remove(STATUS)
        except OSError:
            pass
        sys.exit(0)

    signal.signal(signal.SIGTERM, bye)
    signal.signal(signal.SIGINT, bye)
    last_heard = 0.0
    while True:
        setting = mode_setting()
        heard = bus_heard()
        now = time.time()
        if heard:
            last_heard = now
        live = now - last_heard < QUIET_S
        if rec.mode and (setting != rec.mode or not live):
            rec.stop()
        if not rec.mode and setting != "off" and heard:
            rec.start(setting)
        rec.check()
        rec.status(setting, live)
        time.sleep(TICK_S)


if __name__ == "__main__":
    main()
