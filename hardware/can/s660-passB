#!/bin/sh
# Stage 6 pass B (DIAG-PLAN): the engine computer's full 0x22 range, one piece per run.
# Each run stops after 45 min or below 12.1 V and the next run resumes from the saved state.
D=/usr/local/sbin/s660-diag
L=/persist/can/$(date +%F-%H%M)-diag-passB
$D session-start || exit 1
candump -L any > "$L.log" & REC=$!
echo "== fault codes before"; $D obd --29 03; $D obd --29 07
echo "== module 10"; $D sweep 10 0000 FFFF --skip-f1 --min-mv 12100 --max-minutes 45 || echo "module 10: sweep stopped early"
echo "== fault codes after"; $D obd --29 03; $D obd --29 07
kill $REC 2>/dev/null
